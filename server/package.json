{
  "name": "directions-api-server",
  "version": "1.0.0",
  "description": "A production-ready API server for the Directions application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write 'src/**/*.js'",
    "seed:test": "node src/scripts/seedTestUsers.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "reset:admin": "node src/scripts/resetAdminPassword.js"
  },
  "keywords": [
    "express",
    "api",
    "eta",
    "prediction",
    "directions"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "jsonwebtoken": "^9.0.2",
    "localtunnel": "^2.0.2",
    "moment-timezone": "^0.5.48",
    "mongoose": "^8.14.0",
    "ngrok": "^5.0.0-beta.2",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.5",
    "python-shell": "^5.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.8.7",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
